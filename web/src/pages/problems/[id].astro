---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AnimationPlayer from '../../components/AnimationPlayer.svelte';
import CodeViewer from '../../components/CodeViewer.svelte';
import ProblemProgress from '../../components/ProblemProgress.svelte';
import problemsData from '../../data/problems.json';
import { categoryMeta, inlineMarkdown, teaching } from '../../lib/teaching';
import type { Problem } from '../../lib/types';

const all = problemsData as unknown as Problem[];
export function getStaticPaths() {
  return (problemsData as unknown as Problem[]).map((problem) => ({ params: { id: String(problem.num) }, props: { problem } }));
}
const { problem } = Astro.props as { problem: Problem };
const lesson = teaching(problem);
const currentIndex = all.findIndex((item) => item.num === problem.num);
const previous = all[currentIndex - 1];
const next = all[currentIndex + 1];
const homeHref = '../../';
const category = categoryMeta[problem.category]?.label ?? problem.category;
---
<BaseLayout title={`Q${problem.num} ${problem.title} · Hot 100 C++`} description={`${problem.title}：${problem.tag}`} homeHref={homeHref}>
  <section class="container py-8 sm:py-11">
    <div class="crumb"><a href={homeHref}>题库</a><span>/</span><a href={`${homeHref}#problems`}>{category}</a><span>/</span><b>Q{problem.num}</b></div>
    <header class="problem-hero glass">
      <div class="min-w-0">
        <p class="eyebrow">{category} · #{String(problem.num).padStart(3, '0')}</p>
        <div class="mt-2 flex flex-wrap items-center gap-3"><h1>Q{problem.num} {problem.title}</h1><span class={`difficulty ${problem.diff.toLowerCase()}`}>{problem.diff}</span>{problem.anim && <span class="anim-badge">▶ 可播放动图</span>}</div>
        <p class="mt-4 max-w-3xl text-[var(--muted)]">{problem.tag}</p>
      </div>
      <div class="flex flex-wrap items-center gap-2"><ProblemProgress client:load num={problem.num} /><a class="source-link" href={problem.url} target="_blank" rel="noreferrer">力扣原题 ↗</a></div>
    </header>

    <div class="content-grid mt-6">
      <aside class="side-nav glass">
        <p>本题导航</p><a href="#answer">核心结论</a><a href="#description">题目描述</a><a href="#guide">分步讲解</a>{problem.anim && <a href="#animation">动画演示</a>}{problem.diagramHtml && <a href="#diagram">结构图解</a>}<a href="#code">C++ 实现</a><a href="#tests">测试用例</a>
      </aside>

      <article class="min-w-0 space-y-6">
        <section id="answer" class="answer-card">
          <span class="answer-index">01</span><div><p class="eyebrow">先记住这一句</p><h2>{lesson.takeaway}</h2><p>{lesson.meta.why}</p></div>
        </section>

        {problem.desc?.zh && <section id="description" class="section-card glass"><div class="section-heading"><span>02</span><div><p class="eyebrow">题目描述</p><h2>先把输入、输出和限制读明白</h2></div></div><div class="prose-cn mt-5" set:html={problem.desc.zh}></div></section>}

        <section id="guide" class="section-card glass">
          <div class="section-heading"><span>03</span><div><p class="eyebrow">分步讲解</p><h2>把“会做”拆成可执行的思考步骤</h2></div></div>
          <div class="teach-grid mt-5">
            <div class="teach-card"><span>为什么用 {lesson.meta.label}</span><p>{lesson.meta.why}</p></div>
            <div class="teach-card"><span>复杂度</span><p set:html={inlineMarkdown(lesson.complexity)}></p></div>
          </div>
          {lesson.steps.length > 0 && <ol class="steps">{lesson.steps.map((step, index) => <li><b>{String(index + 1).padStart(2, '0')}</b><span set:html={inlineMarkdown(step)}></span></li>)}</ol>}
          {lesson.tips.length > 0 && <div class="tips"><strong>容易漏掉的点</strong>{lesson.tips.map((tip) => <p set:html={inlineMarkdown(tip)}></p>)}</div>}
        </section>

        {problem.anim && <section id="animation" class="section-card glass"><div class="section-heading"><span>04</span><div><p class="eyebrow">动画演示</p><h2>逐帧观察状态如何变化</h2></div></div><p class="mt-3 text-sm text-[var(--muted)]">可用 0.5×、0.75× 慢放；每一帧都会解释当前不变量或决策。</p><div class="mt-5"><AnimationPlayer client:load script={problem.anim} /></div></section>}

        {problem.diagramHtml && <section id="diagram" class="section-card glass"><div class="section-heading"><span>{problem.anim ? '05' : '04'}</span><div><p class="eyebrow">结构图解</p><h2>使用本仓库真实测试数据</h2></div></div><div class="diagram-wrap mt-5" set:html={problem.diagramHtml}></div></section>}

        <section id="code" class="section-card glass"><div class="section-heading"><span>{problem.anim || problem.diagramHtml ? '06' : '04'}</span><div><p class="eyebrow">C++17 实现</p><h2>保持 LeetCode 可直接提交的 Solution 写法</h2></div></div><div class="mt-5"><CodeViewer client:load code={problem.code} /></div></section>

        <section id="tests" class="section-card glass"><div class="section-heading"><span>✓</span><div><p class="eyebrow">仓库测试</p><h2>实现和测试一一对应</h2></div></div><div class="mt-5 space-y-3">{problem.tests.map(([suite, name, body]) => <details><summary><code>{suite}.{name}</code><span>展开测试</span></summary><pre>{body.trim()}</pre></details>)}</div></section>
      </article>
    </div>

    <nav class="pager mt-8"><a class={previous ? '' : 'list-none'} href={previous ? `../${previous.num}/` : '#'}>{previous ? `← Q${previous.num} ${previous.title}` : '已经是第一题'}</a><a class={next ? '' : 'list-none'} href={next ? `../${next.num}/` : '#'}>{next ? `Q${next.num} ${next.title} →` : '已经是最后一题'}</a></nav>
  </section>
</BaseLayout>

<style>
  .crumb{display:flex;gap:.55rem;color:var(--muted);font-size:.83rem}.crumb a:hover{color:var(--brand)}
  .problem-hero{display:flex;align-items:flex-start;justify-content:space-between;gap:1.5rem;margin-top:1rem;border-radius:1.35rem;padding:1.35rem}.problem-hero h1{margin:0;font-size:clamp(1.65rem,4vw,2.55rem);line-height:1.15;letter-spacing:-.05em}.source-link{border:1px solid var(--line);border-radius:999px;padding:.48rem .72rem;color:var(--muted);font-size:.8rem;font-weight:750}.source-link:hover{border-color:var(--brand);color:var(--brand)}
  .difficulty,.anim-badge{border-radius:999px;padding:.27rem .58rem;font-size:.7rem;font-weight:850}.difficulty.easy{background:#dcfce7;color:#15803d}.difficulty.medium{background:#fef3c7;color:#b45309}.difficulty.hard{background:#ffe4e6;color:#be123c}.anim-badge{background:#ede9fe;color:#6d28d9}:global(.dark) .difficulty.easy{background:#143323;color:#86efac}:global(.dark) .difficulty.medium{background:#3a2b12;color:#fcd34d}:global(.dark) .difficulty.hard{background:#3c1823;color:#fda4af}:global(.dark) .anim-badge{background:#30234d;color:#d8b4fe}
  .content-grid{display:grid;grid-template-columns:12.25rem minmax(0,1fr);gap:1.25rem}.side-nav{position:sticky;top:5.4rem;height:max-content;border-radius:1rem;padding:.8rem}.side-nav p{margin:.25rem .45rem .55rem;color:var(--muted);font-size:.75rem;font-weight:800}.side-nav a{display:block;border-radius:.6rem;padding:.52rem .55rem;color:var(--muted);font-size:.82rem}.side-nav a:hover{background:color-mix(in srgb,var(--brand) 10%,transparent);color:var(--brand)}
  .section-card{scroll-margin-top:5rem;border-radius:1.2rem;padding:1.2rem}.section-heading{display:flex;align-items:center;gap:.75rem}.section-heading>span{display:grid;width:2rem;height:2rem;place-items:center;border-radius:.65rem;background:linear-gradient(145deg,#e7e4ff,#fae8ff);color:#6546d8;font:800 .75rem var(--font-mono)}:global(.dark) .section-heading>span{background:#30234d;color:#d8b4fe}.section-heading h2{margin:.16rem 0 0;font-size:1.1rem;letter-spacing:-.025em}
  .answer-card{display:flex;gap:1rem;border:1px solid #bcb4ff;border-radius:1.2rem;background:linear-gradient(125deg,rgba(108,92,255,.16),rgba(217,70,239,.10));padding:1.2rem}.answer-index{display:grid;width:2.2rem;height:2.2rem;flex:0 0 auto;place-items:center;border-radius:.7rem;background:#6657ff;color:#fff;font:800 .78rem var(--font-mono)}.answer-card h2{margin:.3rem 0;font-size:1.2rem;line-height:1.45}.answer-card p:last-child{margin:0;color:var(--muted);font-size:.9rem;line-height:1.7}
  .teach-grid{display:grid;grid-template-columns:1fr 1fr;gap:.75rem}.teach-card{border:1px solid var(--line);border-radius:.85rem;background:var(--surface-solid);padding:.9rem}.teach-card span{color:var(--brand);font-size:.75rem;font-weight:850}.teach-card p{margin:.4rem 0 0;color:var(--muted);font-size:.88rem;line-height:1.7}.steps{display:grid;gap:.7rem;margin:1rem 0 0;padding:0;list-style:none}.steps li{display:grid;grid-template-columns:2rem 1fr;gap:.55rem;align-items:flex-start;border-left:2px solid color-mix(in srgb,var(--brand) 28%,transparent);padding:.25rem 0 .25rem .8rem;color:var(--muted);font-size:.91rem;line-height:1.75}.steps b{color:var(--brand);font:.72rem var(--font-mono);padding-top:.35rem}.tips{margin-top:1rem;border-radius:.85rem;background:color-mix(in srgb,#f59e0b 11%,var(--surface-solid));padding:.85rem 1rem}.tips strong{color:#a16207;font-size:.83rem}.tips p{margin:.4rem 0 0;color:var(--muted);font-size:.86rem;line-height:1.65}
  details{border:1px solid var(--line);border-radius:.8rem;background:var(--surface-solid)}summary{display:flex;justify-content:space-between;gap:1rem;cursor:pointer;padding:.8rem .9rem;color:var(--muted);font-size:.82rem}summary code{color:var(--brand);font-family:var(--font-mono)}details pre{overflow:auto;margin:0;border-top:1px solid var(--line);padding:1rem;color:var(--muted);font:.8rem/1.7 var(--font-mono)}.pager{display:flex;justify-content:space-between;gap:1rem}.pager a{max-width:48%;border:1px solid var(--line);border-radius:.8rem;background:var(--surface);padding:.75rem .9rem;color:var(--muted);font-size:.84rem;font-weight:750}.pager a:hover{border-color:var(--brand);color:var(--brand)}.pager a.list-none{pointer-events:none;opacity:.5}
  @media(max-width:850px){.problem-hero{flex-direction:column}.content-grid{grid-template-columns:1fr}.side-nav{display:none}}@media(max-width:560px){.section-card{padding:1rem}.teach-grid{grid-template-columns:1fr}.pager{flex-direction:column}.pager a{max-width:none}.problem-hero{padding:1rem}}
</style>
